{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YORVA",
  "version": "0.4.0",
  "identifier": "com.yorva.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. build:sidecar && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../.. build:sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YORVA",
        "width": 1024,
        "height": 680,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "yolin",
    "copyright": "yolin",
    "shortDescription": "Local-first AI Runtime control center",
    "longDescription": "YORVA manages local AI Runtime instances and preserves user-owned Runtime data when the application is repaired or uninstalled.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "upgradeCode": "e793918b-37eb-5e2f-b866-5fc4aa3ac75a",
        "template": "wix/main.wxs"
      }
    },
    "externalBin": ["binaries/yorvad"],
    "resources": [
      "resources/installer/DATA_RETENTION.txt",
      "resources/hermes/source/LICENSE",
      "resources/hermes/source/NODE-LICENSE",
      "resources/hermes/source/NPM-LICENSE"
    ]
  }
}
