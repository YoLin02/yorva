{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YORVA",
  "version": "0.3.1",
  "identifier": "com.yorva.desktop.dev",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. build:sidecar && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../.. build:sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YORVA",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "yolin",
    "copyright": "yolin",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "externalBin": ["binaries/yorvad"],
    "resources": [
      "resources/hermes/source/LICENSE",
      "resources/hermes/source/NODE-LICENSE",
      "resources/hermes/source/NPM-LICENSE"
    ]
  }
}
